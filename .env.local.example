# Next.js Public Client Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private Service Role Key (Used in Edge Route/Server Actions only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Config
GEMINI_API_KEY=AIzaSy...

# Upstash Redis (For Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# App URL (For Auth Callback redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter API Configuration
OPENROUTER_API_KEY=your-openrouter-key-here

# LLM Model Routing Configurations (Defaults)
DEFAULT_LLM_MODEL=google/gemini-2.5-flash
MODEL_OVERRIDE_GEMINI_1_5_PRO=google/gemini-2.5-flash
MODEL_OVERRIDE_GEMINI_1_5_FLASH=google/gemini-2.5-flash
